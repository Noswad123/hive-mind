# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS build

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p hive

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=build /src/target/release/hive /usr/local/bin/hive

RUN useradd --create-home --shell /usr/sbin/nologin hive \
  && mkdir -p /data \
  && chown -R hive:hive /app /data

ENV HIVE_ADDR=0.0.0.0:8080
ENV HIVE_STORE=memory
ENV HIVE_SQLITE_PATH=/data/hive-sync.db
ENV HIVE_SYNC_PERMISSIVE_CORS=true

EXPOSE 8080

USER hive

ENTRYPOINT ["hive", "serve"]
